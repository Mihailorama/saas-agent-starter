{
  "uid": "worker",
  "title": "Worker (Temporal SDK)",
  "description": "Temporal Python SDK metrics, exported by the worker over OTLP/HTTP.",
  "tags": ["saas-agent-starter"],
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Activities per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (activity_type) (rate(temporal_activity_execution_latency_seconds_count{job=\"temporal-core-sdk\"}[$__rate_interval]))",
          "legendFormat": "{{activity_type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Activity execution p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, activity_type) (rate(temporal_activity_execution_latency_seconds_bucket{job=\"temporal-core-sdk\"}[$__rate_interval])))",
          "legendFormat": "{{activity_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Activity failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (activity_type) (rate(temporal_activity_execution_failed_total{job=\"temporal-core-sdk\"}[$__rate_interval]))",
          "legendFormat": "{{activity_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Activity schedule-to-start p95 (queueing)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_activity_schedule_to_start_latency_seconds_bucket{job=\"temporal-core-sdk\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Workflow end-to-end p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, workflow_type) (rate(temporal_workflow_endtoend_latency_seconds_bucket{job=\"temporal-core-sdk\"}[$__rate_interval])))",
          "legendFormat": "{{workflow_type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Task slots used / available",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type) (temporal_worker_task_slots_used{job=\"temporal-core-sdk\"})",
          "legendFormat": "used {{worker_type}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type) (temporal_worker_task_slots_available{job=\"temporal-core-sdk\"})",
          "legendFormat": "available {{worker_type}}"
        }
      ]
    }
  ]
}
