# Local development defaults (also used by tests and CI). Copy to .env to override.
# Never put real secrets here. Production gets its env from the orchestrator.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Restricted app role: RLS is enforced. Created by `pnpm db:migrate`.
DATABASE_URL=postgres://app_user:app_user_password@localhost:5432/app
# Schema owner, used only by migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Error tracking (Sentry protocol: Sentry or GlitchTip). Empty = off. Release = git sha.
# SENTRY_DSN=http://example-key@localhost:8000/1
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# VITE_SENTRY_DSN=http://example-key@localhost:8000/3
# Two-factor and passkeys (docs/adr/0017-two-factor-and-passkeys.md). APP_NAME is shown in
# authenticator apps and passkey prompts. The WebAuthn RP ID must be the app's registrable
# domain (no scheme/port) and the origin exactly what the browser shows; both default to
# BETTER_AUTH_URL. Changing the RP ID later invalidates every registered passkey.
# APP_NAME=Workspace
# PASSKEY_RP_ID=app.example.com
# PASSKEY_ORIGIN=https://app.example.com
# SSO: register ${BETTER_AUTH_URL}/api/auth/callback/oidc at the IdP (see README "SSO").
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=example-client-id
# OIDC_CLIENT_SECRET=example-client-secret
# Transactional email (docs/email.md), sent by the worker. smtps://user:pass@host:465,
# smtp://user:pass@host:587 (STARTTLS required) or ?tls=none for the local Mailpit only.
SMTP_URL=smtp://localhost:1025?tls=none
MAIL_FROM=Workspace <no-reply@example.com>
# REQUIRE_EMAIL_VERIFICATION=true
# Mailpit UI + API (tests read the mails here).
MAILPIT_URL=http://localhost:8025
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
# AI layer (docs/ai-act.md). The contour selects the allowed models in config/ai-models.json;
# empty disables all LLM calls. No model is ever defaulted: set one per purpose to enable it.
AI_CONTOUR=eu
AI_CONTENT_RETENTION_DAYS=180
# AI_PROJECT_SUMMARY_PROVIDER=anthropic
# AI_PROJECT_SUMMARY_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://llm.example.com/v1
# Product analytics (docs/product-analytics.md). Every sink is off while its variable is empty;
# with all of them empty the browser makes no analytics request at all.
# PostHog Cloud (default tool): project key + ingestion host (EU or US region).
# VITE_POSTHOG_KEY=phc_example
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Thumbs up/down on AI answers -> PostHog AI observability survey (ids printed by journeys:sync).
# VITE_POSTHOG_AI_FEEDBACK_SURVEY_ID=
# VITE_POSTHOG_AI_FEEDBACK_QUESTION_ID=
# Self-hosted fallback (no data leaves your servers): Umami, `docker compose --profile analytics`.
# VITE_UMAMI_SCRIPT_URL=http://localhost:3100/script.js
# VITE_UMAMI_WEBSITE_ID=
# Optional, consent-gated: Google Analytics 4 and Yandex Metrika (RU contour).
# VITE_GA4_ID=G-EXAMPLE
# VITE_YM_ID=
# VITE_YM_WEBVISOR=false
# Langfuse (AI-answer scores, scores-only public key).
# VITE_LANGFUSE_PUBLIC_KEY=pk-lf-example
# VITE_LANGFUSE_HOST=https://cloud.langfuse.com
# VITE_RELEASE=dev
# Analytics-as-code scripts (pnpm journeys:sync / journeys:report). Personal API key, never in the web.
# POSTHOG_APP_HOST=https://eu.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=
# UMAMI_URL=http://localhost:3100
# UMAMI_API_KEY=
# UMAMI_WEBSITE_ID=
# Alert-to-issue loop: PostHog webhook destinations call POST /api/hooks/posthog with this secret.
POSTHOG_WEBHOOK_SECRET=local-dev-posthog-webhook-secret
# PUBLIC_API_URL=https://app.example.com
# GITHUB_TOKEN=
# GITHUB_REPO=example/app
