# Local development defaults (also used by tests and CI). Copy to .env to override.
# Never put real secrets here. Production gets its env from the orchestrator.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Restricted app role: RLS is enforced. Created by `pnpm db:migrate`.
DATABASE_URL=postgres://app_user:app_user_password@localhost:5432/app
# Schema owner, used only by migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SSO: register ${BETTER_AUTH_URL}/api/auth/callback/oidc at the IdP (see README "SSO").
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=example-client-id
# OIDC_CLIENT_SECRET=example-client-secret
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
# AI layer (docs/ai-act.md). The contour selects the allowed models in config/ai-models.json;
# empty disables all LLM calls. No model is ever defaulted: set one per purpose to enable it.
AI_CONTOUR=eu
AI_CONTENT_RETENTION_DAYS=180
# AI_PROJECT_SUMMARY_PROVIDER=anthropic
# AI_PROJECT_SUMMARY_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://llm.example.com/v1
# LLM-ops (docs/adr/0009-llm-ops.md). Judge model for the daily drift check; unset = off.
# AI_JUDGE_PROVIDER=anthropic
# AI_JUDGE_MODEL=claude-sonnet-5-5
# AI_DRIFT_CRON=0 3 * * *
# Link from an AI call to its trace, e.g. Jaeger: http://localhost:16686/trace/{traceId}
# TRACE_URL_TEMPLATE=
# Full LLM-ops (`docker compose --profile llmops up -d`, Langfuse on :3100, admin@example.com /
# local-dev-password). The worker pushes judge scores to LANGFUSE_INTERNAL_HOST=http://langfuse-web:3000;
# scripts (`pnpm langfuse:prompts`) use LANGFUSE_HOST=http://localhost:3100. Spans go to Langfuse's OTLP endpoint:
# WORKER_OTEL_TRACES_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
# WORKER_OTEL_TRACES_HEADERS=Authorization=Basic%20cGstbGYtbG9jYWwtZGV2OnNrLWxmLWxvY2FsLWRldg==,x-langfuse-ingestion-version=4
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# Browser feedback scores (LangfuseWeb, public key only): the origin browsers reach Langfuse on.
# LANGFUSE_PUBLIC_URL=http://localhost:3100
# TRACE_URL_TEMPLATE=http://localhost:3100/project/local-dev-project/traces/{traceId}
