# Local development defaults (also used by tests and CI). Copy to .env to override.
# Never put real secrets here. Production gets its env from the orchestrator.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Restricted app role: RLS is enforced. Created by `pnpm db:migrate`.
DATABASE_URL=postgres://app_user:app_user_password@localhost:5432/app
# Schema owner, used only by migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Error tracking (Sentry protocol: Sentry or GlitchTip). Empty = off. Release = git sha.
# SENTRY_DSN=http://example-key@localhost:8000/1
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# VITE_SENTRY_DSN=http://example-key@localhost:8000/3
# Two-factor and passkeys (docs/adr/0017-two-factor-and-passkeys.md). APP_NAME is shown in
# authenticator apps and passkey prompts. The WebAuthn RP ID must be the app's registrable
# domain (no scheme/port) and the origin exactly what the browser shows; both default to
# BETTER_AUTH_URL. Changing the RP ID later invalidates every registered passkey.
# APP_NAME=Workspace
# PASSKEY_RP_ID=app.example.com
# PASSKEY_ORIGIN=https://app.example.com
# SSO: register ${BETTER_AUTH_URL}/api/auth/callback/oidc at the IdP (see README "SSO").
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=example-client-id
# OIDC_CLIENT_SECRET=example-client-secret
# Transactional email (docs/email.md), sent by the worker. smtps://user:pass@host:465,
# smtp://user:pass@host:587 (STARTTLS required) or ?tls=none for the local Mailpit only.
SMTP_URL=smtp://localhost:1025?tls=none
MAIL_FROM=Workspace <no-reply@example.com>
# REQUIRE_EMAIL_VERIFICATION=true
# Mailpit UI + API (tests read the mails here).
MAILPIT_URL=http://localhost:8025
REDIS_URL=redis://localhost:6379
# Public API and webhooks (docs/public-api.md). Requests per minute per API key (Redis).
API_KEY_RATE_LIMIT_PER_MINUTE=600
# Keys encrypting webhook signing secrets at rest, `id:secret` (32+ chars), comma-separated, first
# one active. API and worker need the same value. Production: `prod-2026:$(openssl rand -base64 32)`;
# to rotate, put a new key first: the worker's daily schedule re-encrypts, then drop the old one.
WEBHOOK_ENCRYPTION_KEYS=local-dev:change-me-local-dev-webhook-encryption-key
# Worker: disable an endpoint after N failed deliveries in a row (0 = never; 410 disables at once)
# and delete webhook events/attempts older than N days (0 = keep).
WEBHOOK_DISABLE_AFTER_FAILURES=5
WEBHOOK_RETENTION_DAYS=30
# Largest webhook body publishEvent() accepts; the worker refuses larger ones too.
WEBHOOK_MAX_PAYLOAD_BYTES=65536
# Worker: webhook targets in non-global ranges are refused; allow some CIDRs anyway (on-prem
# receivers). Never broad private ranges in a multi-tenant deployment.
# WEBHOOK_ALLOWED_CIDRS=
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
# AI layer (docs/ai-act.md). The contour selects the allowed models in config/ai-models.json;
# empty disables all LLM calls. No model is ever defaulted: set one per purpose to enable it.
AI_CONTOUR=eu
# Worker: AI request/response content is deleted this many days after the call (daily schedule
# `privacy-retention`); the ai_calls row stays (docs/privacy.md).
AI_CONTENT_RETENTION_DAYS=180
# AI_PROJECT_SUMMARY_PROVIDER=anthropic
# AI_PROJECT_SUMMARY_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://llm.example.com/v1
# Product analytics (docs/product-analytics.md). Every sink is off while its variable is empty;
# with all of them empty the browser makes no analytics request at all.
# PostHog Cloud (default tool): project key + ingestion host (EU or US region).
# VITE_POSTHOG_KEY=phc_example
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Thumbs up/down on AI answers -> PostHog AI observability survey (ids printed by journeys:sync).
# VITE_POSTHOG_AI_FEEDBACK_SURVEY_ID=
# VITE_POSTHOG_AI_FEEDBACK_QUESTION_ID=
# Self-hosted fallback (no data leaves your servers): Umami, `docker compose --profile analytics`.
# VITE_UMAMI_SCRIPT_URL=http://localhost:3100/script.js
# VITE_UMAMI_WEBSITE_ID=
# Optional, consent-gated: Google Analytics 4 and Yandex Metrika (RU contour).
# VITE_GA4_ID=G-EXAMPLE
# VITE_YM_ID=
# VITE_YM_WEBVISOR=false
# Consent regime, read by the web container's nginx (docs/product-analytics.md#consent).
# CONSENT_MODE=opt-in
# CONSENT_COUNTRY_HEADER=cf_ipcountry
# CONSENT_OPT_OUT_COUNTRIES=US
# Langfuse (AI-answer scores, scores-only public key).
# VITE_LANGFUSE_PUBLIC_KEY=pk-lf-example
# VITE_LANGFUSE_HOST=https://cloud.langfuse.com
# VITE_RELEASE=dev
# Analytics-as-code scripts (pnpm journeys:sync / journeys:report). Personal API key, never in the web.
# POSTHOG_APP_HOST=https://eu.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=   (scopes: insight/alert/survey/hog_function:write; feature_flag:write for flags:sync)
# UMAMI_URL=http://localhost:3100
# UMAMI_API_KEY=
# UMAMI_WEBSITE_ID=
# Alert-to-issue loop: PostHog webhook destinations call POST /api/hooks/posthog with this secret.
POSTHOG_WEBHOOK_SECRET=local-dev-posthog-webhook-secret
# Presidio PII redaction of survey answers before they become issues (docs/support.md "Personal
# data"): `docker compose --profile pii up -d pii`, then http://localhost:8010 (API in compose:
# http://pii:8000). Set = fail closed when it is down; unset = only emails are masked.
# PII_REDACT_URL=http://localhost:8010
# PUBLIC_API_URL=https://app.example.com
# Billing (docs/billing.md). Contour of new subscriptions (config/plans.json; `en` = Stripe).
BILLING_CONTOUR=en
# Local defaults talk to stripe-mock (`docker compose --profile billing up -d stripe-mock`); no real
# keys here or in CI. Production: your Stripe secret key and the endpoint's signing secret.
STRIPE_SECRET_KEY=sk_test_123
STRIPE_WEBHOOK_SECRET=whsec_local_dev_example
STRIPE_API_URL=http://localhost:12111
# GITHUB_TOKEN=
# GITHUB_REPO=example/app
# Backups (docs/backups.md): enabled by COMPOSE_FILE=docker-compose.yml:compose.backup.yaml.
# Unset = the local backup-s3 stand-in. Production: a bucket on another machine/provider.
# BACKUP_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
# BACKUP_S3_HTTPS_PORT=443
# BACKUP_S3_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# BACKUP_S3_REGION=eu-central-1
# BACKUP_S3_BUCKET=example-app-backups
# BACKUP_S3_URI_STYLE=host
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Set before the first start and keep a copy off the server: no passphrase, no restore.
# BACKUP_ENCRYPTION_PASSPHRASE=local-dev-backup-passphrase
# BACKUP_RETENTION_FULL=4
# BACKUP_FULL_CRON="0 2 * * 0"
# BACKUP_DIFF_CRON="0 2 * * 1-6"
# BACKUP_OBJECTS_CRON="15 * * * *"
# RESTORE_CHECK_CRON="0 4 * * 0"
# RESTORE_POSTGRES_PORT=5433
# Service desk (docs/support.md): Chatwoot (`docker compose --profile support`) + tracker.
# All empty = no Help entry in the web, webhook endpoints answer 401, the worker only logs.
# Web (build time) + web container CSP:
# VITE_CHATWOOT_BASE_URL=http://localhost:3300
# VITE_CHATWOOT_WEBSITE_TOKEN=
# SUPPORT_ORIGINS=http://localhost:3300
# API: website inbox HMAC token (identity validation) and webhook secrets.
# CHATWOOT_HMAC_TOKEN=
# CHATWOOT_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=
# PLANE_WEBHOOK_SECRET=
# Worker: Chatwoot API (bot agent's access token), tracker, triage model.
# CHATWOOT_URL=http://localhost:3300
# CHATWOOT_PUBLIC_URL=https://support.example.com
# CHATWOOT_API_TOKEN=
# SUPPORT_TRACKER=github
# PLANE_API_URL=https://plane.example.com
# PLANE_APP_URL=
# PLANE_WORKSPACE=
# PLANE_PROJECT_ID=
# PLANE_API_TOKEN=
# AI_SUPPORT_TRIAGE_PROVIDER=anthropic
# AI_SUPPORT_TRIAGE_MODEL=claude-haiku-5-5
# SUPPORT_AI_ORG_ID=
# SUPPORT_NOTIFY_ON_CLOSE=false   # true: on close; release: on the "Released in v..." comment
# Chatwoot containers (production values; local defaults are in docker-compose.yml):
# CHATWOOT_SECRET_KEY_BASE=
# CHATWOOT_DB_PASSWORD=        # role `chatwoot` on the stack Postgres; set a real one outside local dev
# CHATWOOT_FRONTEND_URL=https://support.example.com
# CHATWOOT_SMTP_ADDRESS=smtp.example.com
# CHATWOOT_SMTP_PORT=587
# CHATWOOT_SMTP_STARTTLS=true
# CHATWOOT_SMTP_USERNAME=
# CHATWOOT_SMTP_PASSWORD=
# Attachments: any S3 (default: the stack's SeaweedFS, bucket `chatwoot`). Create the bucket first;
# add it to BACKUP_APP_BUCKETS if you rename it. Telegram/WhatsApp fetch files from this endpoint.
# CHATWOOT_STORAGE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# CHATWOOT_STORAGE_REGION=eu-central-1
# CHATWOOT_STORAGE_BUCKET=chatwoot
# CHATWOOT_STORAGE_ACCESS_KEY_ID=
# CHATWOOT_STORAGE_SECRET_ACCESS_KEY=
# LLM-ops (docs/adr/0009-llm-ops.md). The worker sends every LLM call to PostHog AI observability
# as a `$ai_generation` (same project key and ingestion host as VITE_POSTHOG_*). Unset = nothing
# is sent. Privacy mode keeps prompt and output text out of PostHog (metadata only); set false
# only if the DPA and the users' information allow it (LLM-as-a-judge evaluators need the text).
# POSTHOG_KEY / POSTHOG_HOST: see "Feature flags" below (one PostHog project key for API + worker).
# POSTHOG_PRIVACY_MODE=true
# Langfuse self-hosted (`docker compose --profile llmops up -d`, UI on :3200, admin@example.com /
# local-dev-password): spans go to its OTLP endpoint, `pnpm langfuse:prompts` publishes prompts
# and `pnpm llmops:evaluators` configures judges (LANGFUSE_HOST + key pair).
# WORKER_OTEL_TRACES_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
# WORKER_OTEL_TRACES_HEADERS=Authorization=Basic%20cGstbGYtbG9jYWwtZGV2OnNrLWxmLWxvY2FsLWRldg==,x-langfuse-ingestion-version=4
# LANGFUSE_HOST=http://localhost:3200
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# Feature flags (docs/feature-flags.md). Without POSTHOG_KEY every flag is its catalog default
# (config/flags.json); FLAGS_ON / FLAGS_OFF (comma-separated names) override it, PostHog included.
# FLAGS_ON=
# FLAGS_OFF=
# API + worker: the same PostHog project key and region as VITE_POSTHOG_KEY / VITE_POSTHOG_HOST.
# POSTHOG_KEY=phc_example
# POSTHOG_HOST=https://eu.i.posthog.com
# Optional, API + worker: project secret API key (feature_flag:read) for local evaluation.
# POSTHOG_SECRET_KEY=
# Web (build time): VITE_FLAGS_ON / VITE_FLAGS_OFF; the web uses PostHog only after consent.
# VITE_FLAGS_ON=
# VITE_FLAGS_OFF=
# Marketing layer (docs/marketing.md). Site build: canonical origin, app link, share image
# (absolute URL, hosted outside git), X handle; SITE_NOINDEX=true makes robots.txt disallow all.
# SITE_URL=https://example.com
# SITE_APP_URL=https://app.example.com
# SITE_OG_IMAGE=https://cdn.example.com/og.png
# SITE_TWITTER=@example
# SITE_NOINDEX=true
# IndexNow key (8-128 of a-z A-Z 0-9 -): served as /<key>.txt, used by pnpm seo:indexnow.
# INDEXNOW_KEY=
# Search Console (pnpm seo:report): property + service-account key file path (or its JSON).
# GSC_SITE_URL=sc-domain:example.com
# GSC_CREDENTIALS=/path/to/service-account.json
# docker compose --profile marketing: Postiz (social network app keys go in .env.postiz) and SerpBear.
# POSTIZ_JWT_SECRET=
# POSTIZ_DISABLE_REGISTRATION=true
# SERPBEAR_PASSWORD=
# SERPBEAR_SECRET=
# SERPBEAR_APIKEY=
# SERPBEAR_SEARCH_CONSOLE_CLIENT_EMAIL=
# SERPBEAR_SEARCH_CONSOLE_PRIVATE_KEY=
# Data-subject rights (docs/privacy.md): export ("download my data") and deletion of a user or an
# organization, here and in every configured tool. API: grace period of a deletion (cancellable)
# and the minimum gap between two exports of the same subject. Worker: how long an export ZIP is
# kept, and how long a deleted organization's ai_calls/audit_log record is kept (>= 6 months for
# EU AI Act Art. 26(6) deployers).
# PRIVACY_DELETION_GRACE_DAYS=14
# PRIVACY_EXPORT_INTERVAL_HOURS=24
# PRIVACY_EXPORT_TTL_DAYS=7
# PRIVACY_ORG_RECORDS_DAYS=180
# Worker, per-person export/deletion in the tools (each skipped while empty). PostHog: the private
# API host, POSTHOG_PROJECT_ID and POSTHOG_PERSONAL_API_KEY above, with person:read, person:write and
# query:read scopes. Langfuse: LANGFUSE_HOST + key pair above. Chatwoot: the account id and an
# administrator's access token (agents/bots cannot delete contacts).
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_ADMIN_API_TOKEN=
# GA4 user deletion (Admin API properties.submitUserDeletion): property id (digits) and a service
# account key (JSON on one line) with Editor access to the property; OAuth scope analytics.edit.
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=
