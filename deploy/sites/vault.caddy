# Profile vault (Vaultwarden, docs/secrets.md): its own domain, TLS required (the bw CLI refuses
# plain HTTP). Set VAULT_PUBLIC_URL=https://vault.example.com. /admin answers 403 except from
# VAULT_ADMIN_IPS (space-separated CIDRs; the default 127.0.0.1/32 matches no client, so /admin
# stays closed until you set your address).
{$VAULT_PUBLIC_URL} {
	tls {$CADDY_TLS}
	@admin {
		path /admin /admin/*
		not remote_ip {$VAULT_ADMIN_IPS}
	}
	respond @admin 403
	reverse_proxy vault:80
}
