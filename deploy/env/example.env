# Template for deploy/env/<env>.enc.env (docs/deploy.md). `pnpm run infra` (docs/setup.md) writes
# this file for you from config/components.json. Fake values only. By hand: fill a copy outside
# the repo, encrypt it, delete the plaintext:
#   sops encrypt --filename-override deploy/env/production.enc.env /tmp/production.env \
#     > deploy/env/production.enc.env && shred -u /tmp/production.env
# Later edits: sops edit deploy/env/production.enc.env
# Format: KEY=VALUE, one per line, no quotes, comments on their own lines only.

# --- target, read by scripts/deploy.mjs ---
# ssh destination (user in the docker group), or "local" to deploy on this machine
DEPLOY_HOST=deploy@app.example.com
DEPLOY_PATH=/opt/app
# images are $IMAGE_REPO/{api,worker,web}:<version> (pushed by .github/workflows/release.yml);
# default: the upstream images, ghcr.io/mihailorama/saas-agent-starter
IMAGE_REPO=ghcr.io/example/app
COMPOSE_PROJECT_NAME=app
# on-box services: db (Postgres), s3 (SeaweedFS), ops (Temporal UI on 127.0.0.1), vault, analytics
# (Umami); comma-separated
COMPOSE_PROFILES=db

# --- ingress (deploy/Caddyfile) ---
APP_DOMAIN=app.example.com
# ACME account e-mail, or "internal" for Caddy's own CA
CADDY_TLS=ops@example.com

# --- Postgres (profile db) and the app roles ---
POSTGRES_PASSWORD=change-me-postgres-password
MIGRATION_DATABASE_URL=postgres://postgres:change-me-postgres-password@postgres:5432/app
# restricted role, created by the migrate service; must differ from the migration role
DATABASE_URL=postgres://app_user:change-me-app-user-password@postgres:5432/app
TEMPORAL_DB_PASSWORD=change-me-postgres-password

# --- API ---
# 32+ random characters: openssl rand -hex 32 (the API refuses the change-me value in production)
BETTER_AUTH_SECRET=change-me-auth-secret-at-least-32-characters

# webhook signing secrets at rest, id:secret (32+ chars), comma-separated, first = active
# (docs/public-api.md key rotation); the API refuses change-me values in production
WEBHOOK_ENCRYPTION_KEYS=k1:change-me-webhook-encryption-key-32-chars

# --- object storage: managed S3 / R2 / any S3 API (omit S3_ENDPOINT for AWS) ---
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_PUBLIC_ORIGIN=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=attachments
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key

# --- transactional email, sent by the worker (docs/email.md); sign-in needs a verified address ---
SMTP_URL=smtp://change-me-smtp-user:change-me-smtp-password@smtp.example.com:587
MAIL_FROM=Workspace <no-reply@example.com>

# --- backups (docs/backups.md, docs/deploy.md section 6), profile db only. Off-site repository;
# the deploy stops if the backup sidecar is missing (pass --skip-backup for a managed database).
COMPOSE_FILE=compose.yaml:compose.backup.yaml
BACKUP_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=example-app-backups
BACKUP_S3_URI_STYLE=host
BACKUP_S3_HTTPS_PORT=443
BACKUP_S3_CA_FILE=/etc/ssl/certs/ca-certificates.crt
BACKUP_S3_ACCESS_KEY_ID=change-me-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=change-me-backup-secret-key
# keep a copy off the server: without it the backups cannot be decrypted
BACKUP_ENCRYPTION_PASSPHRASE=change-me-backup-passphrase
BACKUP_S3_LOCAL=0
BACKUP_APP_S3_ENDPOINT=https://s3.example.com
BACKUP_APP_S3_ACCESS_KEY_ID=change-me-s3-access-key
BACKUP_APP_S3_SECRET_ACCESS_KEY=change-me-s3-secret-key

# --- optional (empty or absent = off): SENTRY_DSN, OTEL_EXPORTER_OTLP_ENDPOINT, OIDC_*,
# POSTHOG_WEBHOOK_SECRET, POSTHOG_KEY/POSTHOG_HOST and FLAGS_ON/FLAGS_OFF (docs/feature-flags.md),
# AI_CONTOUR and AI_PROJECT_SUMMARY_* with the provider's settings; see docs/llm-providers.md.
# CLI subscriptions: add llm-cli to COMPOSE_PROFILES and set (image built by you, private registry):
# IMAGE_LLM_CLI=registry.example.com/app/llm-cli@sha256:<digest>
# LLM_CLI_TOKEN=change-me-llm-cli-token-32-chars-minimum
# LLM_CLI_SECRETS_DIR=/srv/app/llm-cli-secrets
# Consent regime for third-party analytics (docs/product-analytics.md#consent): CONSENT_MODE
# (opt-in when absent), CONSENT_COUNTRY_HEADER, CONSENT_OPT_OUT_COUNTRIES (e.g. US).
# Billing (docs/billing.md): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (absent = checkout 503),
# BILLING_CONTOUR (default en), PLANS_FILE on the worker (default config/plans.json in the image).
# Rewards (docs/growth.md): INTERNAL_API_TOKEN (same for API and worker; absent = money rewards go
# to operators as pending_manual), REWARDS_FILE on the worker (default config/rewards.json).
# Referrals: DUB_API_KEY on the API to run them through Dub Partners (absent = native).
# Secrets vault (docs/secrets.md): add vault to COMPOSE_PROFILES (Caddy then serves
# deploy/sites/vault.caddy). VAULT_DB_PASSWORD lets the vault-db one-shot create its database on the
# on-box Postgres; otherwise create it once by hand (docs/deploy.md). Admin token: an argon2 hash from
# `vaultwarden hash`, with every $ doubled to $$ (compose interpolates .env); anything else is
# refused. Remove it to close /admin; Caddy allows /admin only from VAULT_ADMIN_IPS.
# VAULT_ADMIN_IPS=192.0.2.10/32
# VAULT_DB_PASSWORD=change-me-vault-db-password
# VAULT_DATABASE_URL=postgresql://vaultwarden:change-me-vault-db-password@postgres:5432/vaultwarden
# VAULT_PUBLIC_URL=https://vault.example.com
# VAULT_ADMIN_TOKEN=
# VAULT_SMTP_HOST=smtp.example.com
# VAULT_SMTP_FROM=vault@example.com
# VAULT_SMTP_USERNAME=change-me-smtp-user
# VAULT_SMTP_PASSWORD=change-me-smtp-password
# Product analytics on the box (docs/product-analytics.md): add analytics to COMPOSE_PROFILES
# (Umami on its own domain, deploy/sites/analytics.caddy; its database by the umami-db one-shot).
# UMAMI_ADMIN_PASSWORD replaces the default admin login after the first deploy
# (deploy/setup/umami-admin.sh, run by `pnpm run infra`).
# UMAMI_PUBLIC_URL=https://umami.example.com
# UMAMI_DB_PASSWORD=change-me-umami-db-password
# UMAMI_APP_SECRET=change-me-umami-app-secret
# UMAMI_ADMIN_PASSWORD=change-me-umami-admin-password
# ANALYTICS_ORIGINS=https://umami.example.com
