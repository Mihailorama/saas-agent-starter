---
// FAQ section; pair it with faqLd() in the page's jsonLd so the markup matches the visible text.
interface Props {
  items: { q: string; a: string }[];
  /** Container width; match the page's own column (blog posts max-w-3xl, the landing max-w-5xl). */
  width?: 'max-w-3xl' | 'max-w-5xl';
}
const { items, width = 'max-w-3xl' } = Astro.props;
---

<section aria-labelledby="faq" class:list={["mx-auto px-6 py-16", width]}>
  <h2 id="faq" class="text-2xl font-semibold tracking-tight">Frequently asked questions</h2>
  <div class="mt-6 max-w-3xl divide-y rounded-lg border">
    {
      items.map((f) => (
        <details class="group p-4">
          <summary class="cursor-pointer py-1 font-medium">{f.q}</summary>
          <p class="mt-2 max-w-prose text-muted-foreground">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
