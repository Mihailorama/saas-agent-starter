---
import type { ComponentProps } from 'astro/types';
import Seo from '../components/Seo.astro';
import { site } from '../site.ts';
import '../styles.css';

type Props = ComponentProps<typeof Seo>;
const lang = Astro.currentLocale ?? 'en';
const signIn = new URL('/', site.appUrl).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {...Astro.props} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2">Skip to content</a>
    <header class="border-b">
      <nav aria-label="Main" class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-4">
        <a href="/" class="font-semibold">{site.name}</a>
        <a href="/blog/" class="text-sm text-muted-foreground hover:text-foreground">Blog</a>
        <a
          href={signIn}
          data-cta="nav_sign_in"
          class="ml-auto rounded-md border px-3 py-1.5 text-sm hover:bg-secondary">Sign in</a
        >
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t">
      <div class="mx-auto flex max-w-5xl flex-wrap gap-4 px-6 py-6 text-sm text-muted-foreground">
        <span>© {new Date().getFullYear()} {site.organization.name}</span>
        <a href="/blog/" class="hover:text-foreground">Blog</a>
        <a href="/rss.xml" class="hover:text-foreground">RSS</a>
      </div>
    </footer>
    <section
      id="consent"
      hidden
      aria-label="Analytics consent"
      class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-lg border bg-background p-4 text-sm shadow-lg"
    >
      <p>We use analytics to see which pages help visitors. Allow usage analytics?</p>
      <div class="mt-3 flex justify-end gap-2">
        <button type="button" data-consent="denied" class="rounded-md border px-3 py-1.5">Only necessary</button>
        <button type="button" data-consent="granted" class="rounded-md bg-primary px-3 py-1.5 text-primary-foreground">
          Allow
        </button>
      </div>
    </section>
    <script>
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>
