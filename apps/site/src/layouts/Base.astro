---
import type { ComponentProps } from 'astro/types';
import Seo from '../components/Seo.astro';
import { legalLinks } from '../legal-build.ts';
import { posts } from '../posts.ts';
import { path, site } from '../site.ts';
import '../styles.css';

type Props = ComponentProps<typeof Seo>;
const lang = Astro.currentLocale ?? 'en';
// Blog and RSS links only once a post is published: an empty blog is a dead end.
const hasPosts = (await posts()).length > 0;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src={path('/theme.js')}></script>
    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <Seo {...Astro.props} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2">Skip to content</a>
    <header class="border-b">
      <nav aria-label="Main" class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-2">
        <a href={path('/')} class="py-2 font-semibold">{site.name}</a>
        {hasPosts && <a href={path('/blog/')} class="py-2 text-sm text-muted-foreground hover:text-foreground">Blog</a>}
        <a href={`${path('/')}#offers`} class="py-2 text-sm text-muted-foreground hover:text-foreground">Managed</a>
        <span class="ml-auto flex items-center gap-4">
          <a
            href={site.repo}
            data-cta="nav_github"
            class="py-2 text-sm text-muted-foreground hover:text-foreground">GitHub</a
          >
          {
            site.appUrl && (
              <a
                href={new URL('/', site.appUrl).href}
                data-cta="nav_sign_in"
                class="rounded-md border px-3 py-1.5 text-sm hover:bg-secondary">
                Sign in
              </a>
            )
          }
        </span>
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t">
      <div class="mx-auto flex max-w-6xl flex-wrap gap-4 px-6 py-6 text-sm text-muted-foreground">
        <span>© {new Date().getFullYear()} {site.organization.name}</span>
        {hasPosts && <a href={path('/blog/')} class="hover:text-foreground">Blog</a>}
        {hasPosts && <a href={path('/rss.xml')} class="hover:text-foreground">RSS</a>}
        {
          site.channels.length > 0
            ? site.channels.map((c) => (
                <a href={c.href} data-cta={`footer_${c.id}`} class="hover:text-foreground">{c.label}</a>
              ))
            : <a href={site.contact} data-cta="footer_contact" class="hover:text-foreground">Contact</a>
        }
        <a href={site.repo} class="hover:text-foreground">GitHub</a>
        <a href={`${site.repo}/blob/main/LICENSE`} class="hover:text-foreground">License (MIT-0)</a>
        {legalLinks.map((l) => <a href={path(l.href)} data-legal-link={l.id} class="hover:text-foreground">{l.title}</a>)}
        <button type="button" id="privacy-choices" hidden class="hover:text-foreground"></button>
      </div>
    </footer>
    <script>
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>
