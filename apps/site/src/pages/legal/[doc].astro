---
// Legal pages (docs/legal.md), generated from config/legal.json and what the stack uses.
import Base from '../../layouts/Base.astro';
import { DOC_IDS, type DocId } from '../../legal.ts';
import { legal, legalLinks, legalPages } from '../../legal-build.ts';
import { path } from '../../site.ts';

export function getStaticPaths() {
  return DOC_IDS.map((doc) => ({ params: { doc } }));
}
const page = legalPages[Astro.params.doc as DocId];
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base title={page.title} description={`${page.title} of ${legal.company.productName}, version ${page.version}.`}>
  <article class="mx-auto max-w-3xl px-6 py-16" data-legal-doc={page.id} data-legal-version={page.version}>
    <h1 class="text-3xl font-bold tracking-tight">{page.title}</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      Version {page.version}, effective {fmt.format(new Date(page.effective))}
    </p>
    {
      page.sections.map((s) => (
        <section class="mt-10">
          <h2 class="text-xl font-semibold">{s.heading}</h2>
          {s.paragraphs?.map((p) => <p class="mt-3 leading-7">{p}</p>)}
          {s.items && s.items.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 pl-6 leading-7">
              {s.items.map((i) => <li>{i}</li>)}
            </ul>
          )}
          {s.table && s.table.rows.length > 0 && (
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr class="border-b">{s.table.columns.map((c) => <th scope="col" class="py-2 pr-4 font-medium">{c}</th>)}</tr>
                </thead>
                <tbody>
                  {s.table.rows.map((r) => (
                    <tr class="border-b align-top">{r.map((cell) => <td class="py-2 pr-4">{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))
    }
    <nav aria-label="Legal" class="mt-12 border-t pt-6 text-sm">
      <h2 class="font-medium">Related</h2>
      <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        {legalLinks.filter((l) => l.id !== page.id).map((l) => <li><a href={path(l.href)} class="underline">{l.title}</a></li>)}
      </ul>
    </nav>
  </article>
</Base>
