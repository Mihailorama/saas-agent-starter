---
import { render } from 'astro:content';
import Faq from '../../components/Faq.astro';
import { faqLd } from '../../faq.ts';
import Base from '../../layouts/Base.astro';
import { posts } from '../../posts.ts';
import { abs, site } from '../../site.ts';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, faq } = post.data;
const article = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@id': abs('/#organization') },
  mainEntityOfPage: abs(Astro.url.pathname),
  ...(site.ogImage ? { image: site.ogImage } : {}),
};
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'long' });
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={faq ? [article, faqLd(faq)] : [article]}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-muted-foreground">
        {author} · <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
      </p>
    </header>
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
  {faq && <Faq items={faq} />}
</Base>
