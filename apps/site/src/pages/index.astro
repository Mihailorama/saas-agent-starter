---
// The landing page (brand: Orgfold; the repository keeps its name until the rename). Every claim
// here must hold for the code on main: source of truth is AGENTS.md and docs/*.md.
// Positioning: a founder who builds a software company with coding agents and needs the whole
// company's infrastructure, not just an app. Job: have it all on day one, safe, without lock-in.
// Two offers: open source (free) and managed (we host and set it up; no price on the page).
// The full feature list lives in the README; the page links to it instead of repeating it.
import { readdirSync, readFileSync } from 'node:fs';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { faqLd } from '../faq.ts';
import Base from '../layouts/Base.astro';
import { abs, site } from '../site.ts';

const file = (p: string) => `${site.repo}/blob/main/${p}`;
const tree = (p: string) => `${site.repo}/tree/main/${p}`;
// Counted from the repository at build time, so the proof strip cannot drift from the files.
// Builds run in apps/site (pnpm --filter site build); import.meta.url points into the bundle.
const root = new URL('../../', `file://${process.cwd()}/`);
// The site's Docker build copies only apps/site: there a missing count drops its item.
const count = (f: () => number) => {
  try {
    return f();
  } catch {
    return 0;
  }
};
const adrs = count(() => readdirSync(new URL('docs/adr/', root)).filter((f) => /^\d{4}-.+\.md$/.test(f)).length);
const recipes = count(() => readFileSync(new URL('AGENTS.md', root), 'utf8').match(/^## Recipe/gm)?.length ?? 0);

// The hero graphic: the pieces a company runs on, already in one box. Each exists on main
// (README, AGENTS.md architecture map).
const groups = [
  { name: 'Run', items: ['Sign-in and SSO', 'Billing', 'CRM', 'Support desk', 'Admin console'] },
  { name: 'Grow', items: ['Marketing site', 'Analytics', 'Email'] },
  { name: 'Build', items: ['AI gateway', 'API and webhooks', 'Agent rules'] },
  { name: 'Trust', items: ['Deploy', 'Backups', 'Secrets vault', 'Monitoring'] },
];
const pieces = groups.reduce((n, g) => n + g.items.length, 0);

// "Who does what": the split of work the product is built around.
const lanes = [
  {
    icon: 'user',
    who: 'You',
    items: ['Decide what to build next', 'Describe it to your agent', 'Review the result and ship it'],
  },
  {
    icon: 'bot',
    who: 'Your coding agent',
    items: ['Reads the rules in AGENTS.md', 'Follows a recipe for the change', 'Runs pnpm check until it is green'],
  },
  {
    icon: 'box',
    who: `${site.name}, already running`,
    items: ['Sign-in, teams and roles', 'Billing, CRM and support', 'Deploys, backups and monitoring'],
  },
] as const;

// The app mock in "Day one": the real shell's nav (apps/web/src/pages/shell.tsx) and the projects
// table's columns (pages/projects.tsx); sample names per PRODUCT.md.
const nav = ['Projects', 'AI calls', 'Billing', 'Members', 'API keys', 'Webhooks'];
const rows = [
  ['Apollo', 'a3f9 2c71', 'Nov 3'],
  ['Gemini', '7be0 91d4', 'Nov 5'],
  ['Mercury', 'Processing…', 'Today'],
];

// What `pnpm check` runs (AGENTS.md "Definition of done"), in words a founder reads.
const gates = ['Format and lint', 'Types', 'Tests', 'Tenant isolation', 'Licenses', 'Accessibility', 'Visual check'];

// The terminal in "How it works": real commands from AGENTS.md "Setup" and /add-resource.
const session = [
  ['$', `git clone ${site.repo}`],
  ['$', 'docker compose up -d --wait postgres redis s3 temporal-ui mailpit'],
  ['$', 'pnpm i && pnpm db:migrate && pnpm dev'],
  ['$', 'pnpm worker'],
  ['#', 'then ask your agent, e.g. in Claude Code:'],
  ['>', '/add-resource invoices'],
  ['$', 'pnpm check'],
];

// Repo facts a visitor can open and check; no customers, stars or testimonials are claimed.
const proof = [
  { fact: `${recipes} recipes`, text: 'step by step, for the changes agents make most', href: file('AGENTS.md') },
  { fact: `${adrs} decision records`, text: 'one per component pick, with the reason', href: tree('docs/adr') },
  { fact: '3 languages, 1 gate', text: 'TypeScript, Python and Rust behind pnpm check', href: file('package.json') },
  { fact: '~612 MiB', text: 'RAM for the default stack, measured', href: file('docs/STACK.md') },
].filter((p) => !p.fact.startsWith('0 '));

const faq = [
  {
    q: 'What is Orgfold?',
    a: 'Orgfold is an open-source agentic organization in a box: the software a SaaS company runs on (sign-in, billing, CRM, support, analytics, an AI gateway, deploys and backups) plus the rules and checks that let coding agents such as Claude Code and Codex build the product on top.',
  },
  {
    q: 'Do I need to be a developer?',
    a: 'You need to be comfortable letting a coding agent run commands and reading what it reports. If you would rather not run servers at all, the managed option sets everything up for you.',
  },
  {
    q: 'Do I need to know TypeScript, Python and Rust?',
    a: 'No. Your agent writes the code and AGENTS.md tells it which language goes where: TypeScript for the API and the web app, Python for AI and background work, Rust only for a hot path someone has measured. You need Docker and the tools from the quickstart installed.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes. The code is licensed MIT No Attribution (MIT-0): use, change and sell it without keeping a notice. There are no license fees. Every code dependency is permissive or MPL-2.0, enforced in CI.',
  },
  {
    q: 'Can I keep the services I already use?',
    a: 'Yes. Each external service either runs from the box or connects to one you have: managed Postgres or S3, Stripe, PostHog, your own Chatwoot or Twenty, any SMTP provider or LLM provider.',
  },
  {
    q: 'What does the managed option include?',
    a: 'We host Orgfold for you and set it up: servers and domain, the services you already use connected, updates and support. Talk to us for the details and a price.',
  },
  {
    q: 'Which coding agents does it work with?',
    a: 'Any agent that reads AGENTS.md, such as Codex. Claude Code reads CLAUDE.md, which imports AGENTS.md, and adds ready commands such as /add-resource.',
  },
];

const source = {
  '@type': 'SoftwareSourceCode',
  '@id': abs('/#software'),
  name: site.name,
  alternateName: site.repoName,
  description: site.description,
  url: abs('/'),
  codeRepository: site.repo,
  programmingLanguage: ['TypeScript', 'Python', 'Rust'],
  runtimePlatform: ['Node.js', 'Python', 'Docker'],
  license: 'https://spdx.org/licenses/MIT-0.html',
  isAccessibleForFree: true,
  keywords: 'agentic organization, open-source SaaS starter, multi-tenant, AGENTS.md, Claude Code, Codex',
  author: { '@id': abs('/#organization') },
};

const button = 'inline-flex w-full items-center justify-center rounded-md px-5 py-2.5 font-medium sm:w-auto';
const primary = `${button} bg-primary text-primary-foreground hover:bg-primary/90`;
const secondary = `${button} border bg-background hover:bg-secondary`;
const link = 'font-medium text-primary underline-offset-4 hover:underline';
const external = site.contact.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---

<Base title={`${site.name}: ${site.tagline}`} description={site.description} jsonLd={[source, faqLd(faq)]}>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-14 pb-16 sm:pt-20 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        Start a software company with your coding agent, not just an app
      </h1>
      <p class="mt-6 max-w-xl text-lg text-pretty text-muted-foreground">
        {site.name} is the open-source software a SaaS company runs on: sign-in and teams, billing,
        customer records, support, deploys and backups. It is already built and tested, so Claude
        Code or Codex builds only your product.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={site.repo} data-cta="hero_github" class={primary}>Get the code on GitHub</a>
        <a href={site.contact} {...external} data-cta="hero_contact" class={secondary}>Talk to us about setup</a>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">Free and open source (MIT-0). Keep the services you already use.</p>
    </div>

    <figure class="rounded-2xl border bg-card shadow-lg">
      <div class="flex items-center gap-2 border-b px-5 py-3">
        <Icon name="box" class="size-5 text-primary" />
        <span class="font-semibold">{site.name}</span>
        <span class="ml-auto text-sm text-muted-foreground">{pieces} pieces, connected</span>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-5 p-5">
        {
          groups.map((g) => (
            <div>
              <p class="text-sm font-semibold">{g.name}</p>
              <ul class="fold mt-2 flex flex-wrap gap-1.5">
                {g.items.map((p) => <li class="rounded-md bg-primary/10 px-2 py-1 text-xs font-medium sm:text-sm">{p}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <figcaption class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-b-2xl border-t bg-muted/60 px-5 py-3 font-mono text-sm">
        <span><span aria-hidden="true" class="text-muted-foreground">$ </span>pnpm check</span>
        <span class="flex items-center gap-1.5 text-primary"><Icon name="check" />every gate green</span>
      </figcaption>
    </figure>
  </section>

  <section aria-labelledby="who" class="border-y bg-muted/40">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 id="who" class="max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        You decide. Your agent builds. {site.name} already runs the rest.
      </h2>
      <ol class="mt-10 grid gap-4 lg:grid-cols-3 lg:gap-10">
        {
          lanes.map((l, i) => (
            <li class="relative">
              <div class:list={['h-full rounded-xl border p-6', i === 2 ? 'border-primary/40 bg-primary/5' : 'bg-background']}>
                <p class="flex items-center gap-2 font-semibold">
                  <span class:list={['grid size-9 place-items-center rounded-lg', i === 2 ? 'bg-primary text-primary-foreground' : 'bg-muted']}>
                    <Icon name={l.icon} class="size-5" />
                  </span>
                  {l.who}
                </p>
                <ul class="mt-4 space-y-2">
                  {l.items.map((t) => (
                    <li class="flex gap-2 text-muted-foreground">
                      <Icon name="check" class="mt-1 size-4 text-primary" />
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
              {i < 2 && (
                <span class="absolute top-1/2 -right-8 hidden -translate-y-1/2 text-muted-foreground lg:block">
                  <Icon name="arrow" class="size-6" />
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="day-one" class="mx-auto max-w-6xl px-6 py-20">
    <h2 id="day-one" class="max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
      What is running on day one, before your first feature
    </h2>
    <div class="mt-10 grid items-start gap-10 lg:grid-cols-5">
      <figure class="lg:col-span-3">
        <div aria-hidden="true" class="overflow-hidden rounded-xl border bg-background text-sm shadow-lg">
          <div class="flex items-center gap-1.5 border-b bg-muted/60 px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-border"></span>
            <span class="size-2.5 rounded-full bg-border"></span>
            <span class="size-2.5 rounded-full bg-border"></span>
            <span class="ml-3 truncate text-xs text-muted-foreground">app.example.com/projects</span>
          </div>
          <div class="flex">
            <div class="hidden w-40 shrink-0 border-r bg-sidebar p-3 sm:block">
              <p class="mb-3 truncate rounded-md border bg-background px-2 py-1.5 text-xs font-medium">Example Org</p>
              <ul class="space-y-0.5 text-xs">
                {nav.map((n, i) => <li class:list={['rounded-md px-2 py-1.5', i === 0 ? 'bg-accent font-medium' : 'text-muted-foreground']}>{n}</li>)}
              </ul>
            </div>
            <div class="min-w-0 flex-1 p-4">
              <div class="flex items-center justify-between gap-3">
                <p class="text-base font-semibold">Projects</p>
                <span class="rounded-md bg-primary px-2.5 py-1 text-xs font-medium text-primary-foreground">Create project</span>
              </div>
              <div class="mt-3 rounded-lg border">
                <div class="grid grid-cols-3 border-b px-3 py-2 text-xs text-muted-foreground">
                  <span>Name</span><span>Fingerprint</span><span class="text-right">Created</span>
                </div>
                {
                  rows.map(([name, fp, date]) => (
                    <div class="grid grid-cols-3 items-center border-b px-3 py-2.5 text-xs last:border-b-0">
                      <span class="font-medium">{name}</span>
                      <span>
                        <span class:list={['rounded-md px-1.5 py-0.5 tabular-nums', fp.startsWith('P') ? 'text-muted-foreground' : 'bg-secondary']}>{fp}</span>
                      </span>
                      <span class="text-right text-muted-foreground">{date}</span>
                    </div>
                  ))
                }
              </div>
              <p class="mt-3 flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="rounded-full bg-primary px-2 py-0.5 text-primary-foreground">AI-generated</span>
                Summaries are labeled and reviewable
              </p>
            </div>
          </div>
        </div>
        <figcaption class="mt-3 text-sm text-muted-foreground">
          The app you start from. Your product's pages go next to Projects.
        </figcaption>
      </figure>
      <dl class="grid gap-6 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-1">
        <div>
          <dt class="font-semibold">Run the company</dt>
          <dd class="mt-1 text-muted-foreground">Sign-in with SSO and 2FA, teams and roles, billing for any pricing model, CRM, support desk, admin console.</dd>
        </div>
        <div>
          <dt class="font-semibold">Grow it</dt>
          <dd class="mt-1 text-muted-foreground">Marketing site and blog, product analytics, surveys and referral rewards.</dd>
        </div>
        <div>
          <dt class="font-semibold">Trust it with customers</dt>
          <dd class="mt-1 text-muted-foreground">Each customer's data isolated by the database, an audit log, a secrets vault and backups with restore checks.</dd>
        </div>
      </dl>
    </div>
    <p class="mt-8 text-sm">
      <a href={`${site.repo}#readme`} data-cta="readme" class={link}>See the full component list in the README</a>
    </p>
  </section>

  <section id="how" aria-labelledby="how-title" class="border-y bg-muted/40">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 id="how-title" class="max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        Your agent does the work. One command decides when it is done.
      </h2>
      <div class="mt-10 flex flex-col gap-3 lg:flex-row lg:items-stretch">
        <div class="rounded-xl border bg-background p-5 lg:flex-1">
          <Icon name="user" class="size-5 text-muted-foreground" />
          <p class="mt-3 font-semibold">You describe a feature</p>
          <p class="mt-1 text-sm text-muted-foreground">"Add invoices to each customer's account."</p>
        </div>
        <div class="grid shrink-0 place-items-center text-muted-foreground"><Icon name="arrow" class="size-6 rotate-90 lg:rotate-0" /></div>
        <div class="rounded-xl border bg-background p-5 lg:flex-1">
          <Icon name="bot" class="size-5 text-muted-foreground" />
          <p class="mt-3 font-semibold">Your agent follows a recipe</p>
          <p class="mt-1 text-sm text-muted-foreground">AGENTS.md says where the code goes and which tests to add, step by step.</p>
        </div>
        <div class="grid shrink-0 place-items-center text-muted-foreground"><Icon name="arrow" class="size-6 rotate-90 lg:rotate-0" /></div>
        <div class="rounded-xl border border-primary/40 bg-background p-5 lg:flex-1">
          <p class="font-mono text-sm font-semibold">pnpm check</p>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
            {gates.map((g) => <li class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-primary" />{g}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <p class="flex items-center gap-3 rounded-xl border bg-background p-4 text-sm">
          <Icon name="retry" class="size-5 text-muted-foreground" />
          <span><span class="font-semibold">Red:</span> the agent reads what failed, fixes it and runs the check again.</span>
        </p>
        <p class="flex items-center gap-3 rounded-xl border border-primary/40 bg-primary/5 p-4 text-sm">
          <Icon name="check" class="size-5 text-primary" />
          <span><span class="font-semibold">Green:</span> done. You review the result and ship it.</span>
        </p>
      </div>
      <details class="mt-10 max-w-3xl rounded-xl border bg-card">
        <summary class="cursor-pointer px-5 py-3 text-sm font-medium">For developers: the commands behind these steps</summary>
        <pre class="overflow-x-auto border-t p-5 text-sm leading-7"><code>{
          session.map(([prompt, text]) =>
            prompt === '#' ? (
              <span class="block text-muted-foreground"># {text}</span>
            ) : (
              <span class="block"><span aria-hidden="true" class="text-muted-foreground select-none">{prompt} </span>{text}</span>
            ),
          )
        }</code></pre>
        <p class="border-t px-5 py-3 text-sm text-muted-foreground">
          Needs Docker, Node 22.18+ with pnpm, uv and Rust.{' '}
          <a href={`${site.repo}#5-minute-quickstart`} data-cta="quickstart" class={link}>Full quickstart</a>
        </p>
      </details>
    </div>
  </section>

  <section aria-labelledby="proof" class="mx-auto max-w-6xl px-6 py-20">
    <h2 id="proof" class="text-2xl font-semibold tracking-tight sm:text-3xl">Check the claims yourself</h2>
    <p class="mt-3 max-w-xl text-muted-foreground">No customer logos or star counts here, only files you can open.</p>
    <dl class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        proof.map((p) => (
          <div class="border-t pt-4">
            <dt>
              <a href={p.href} class="text-2xl leading-tight font-bold tracking-tight text-primary sm:text-3xl underline-offset-4 hover:underline">
                {p.fact}
              </a>
            </dt>
            <dd class="mt-2 text-sm text-muted-foreground">{p.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="offers" aria-labelledby="offers-title" class="border-y bg-muted/40">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 id="offers-title" class="text-2xl font-semibold tracking-tight sm:text-3xl">Two ways to run {site.name}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="flex flex-col rounded-xl border bg-card p-6 shadow-sm">
          <h3 class="flex items-center gap-2 text-lg font-semibold"><Icon name="bot" class="size-5 text-muted-foreground" />Open source</h3>
          <p class="mt-1 text-sm text-muted-foreground">Free. For you if you, or your agent, can run commands.</p>
          <ul class="mt-5 flex-1 space-y-2">
            {['Runs on your machine or your own server', 'Connect the services you already pay for', 'Change anything, use it for client projects'].map((t) => (
              <li class="flex gap-2"><Icon name="check" class="mt-1 size-4 text-primary" />{t}</li>
            ))}
          </ul>
          <a href={site.repo} data-cta="offer_github" class:list={[primary, 'mt-6 self-start']}>Get the code on GitHub</a>
        </div>
        <div class="flex flex-col rounded-xl border bg-card p-6 shadow-sm">
          <h3 class="flex items-center gap-2 text-lg font-semibold"><Icon name="server" class="size-5 text-muted-foreground" />Managed</h3>
          <p class="mt-1 text-sm text-muted-foreground">We host it and set it up. For you if you'd rather not run servers.</p>
          <ul class="mt-5 flex-1 space-y-2">
            {['Servers and domain', 'Your existing services connected', 'Updates and support, on the same open-source code'].map((t) => (
              <li class="flex gap-2"><Icon name="check" class="mt-1 size-4 text-primary" />{t}</li>
            ))}
          </ul>
          <a href={site.contact} {...external} data-cta="offer_contact" class:list={[secondary, 'mt-6 self-start']}>Talk to us about setup</a>
          {
            site.channels.length > 1 && (
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground">
                <span>Or write to us:</span>
                {site.channels.map((c) => (
                  <a href={c.href} data-cta={`contact_${c.id}`} class="underline-offset-4 hover:text-foreground hover:underline" {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a>
                ))}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} width="max-w-6xl" />

  <section aria-labelledby="start" class="border-t">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-6 py-16 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="start" class="text-2xl font-semibold tracking-tight sm:text-3xl">Start with the whole company in place</h2>
        <p class="mt-2 text-muted-foreground">Open source and free, or hosted and set up by us.</p>
      </div>
      <div class="flex w-full flex-wrap gap-3 md:w-auto">
        <a href={site.repo} data-cta="footer_github" class={primary}>Get the code on GitHub</a>
        <a href={site.contact} {...external} data-cta="footer_contact" class={secondary}>Talk to us about setup</a>
      </div>
    </div>
  </section>
</Base>
