---
// "What is inside": every service in the box with its license and what you can connect instead,
// and the agent skills, ours and others'. Data: src/stack.ts and src/skills.ts, both checked
// against the repository by scripts/site-stack.test.mjs.
import * as simpleIcons from 'simple-icons';
import Base from '../layouts/Base.astro';
import { site } from '../site.ts';
import { ownSkills, thirdPartySkills } from '../skills.ts';
import { stack } from '../stack.ts';

const logoPaths = new Map(Object.values(simpleIcons).map((i) => [i.slug, i.path]));
const bundled = stack.flatMap((g) => g.tools).filter((t) => t.images.length).length;
const groups = ['Build', 'Product', 'Design', 'Trust'] as const;
const file = (p: string) => `${site.repo}/blob/main/${p}`;
---

<Base
  title={`What is inside ${site.name}`}
  description={`The ${bundled} open-source services in ${site.name} with their licenses, the managed services you can connect instead, and the agent skills that come with it.`}
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-4xl">What is inside {site.name}</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
      {bundled} open-source services, each running unmodified in its own container, so each keeps its own license. Switch on only
      the ones you need, and where a card says so, connect a service you already have instead. Your
      code stays under your license; every code dependency is permissive or MPL-2.0, checked in CI.
    </p>

    <h2 class="mt-14 text-2xl font-semibold tracking-tight">Services</h2>
    {
      stack.map((g) => (
        <section class="mt-8" aria-label={g.group}>
          <h3 class="text-sm font-semibold text-muted-foreground">{g.group}</h3>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.tools.map((t) => (
              <li class="flex items-start gap-3 rounded-lg border bg-card p-4">
                {t.icon && logoPaths.get(t.icon) ? (
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 size-7 shrink-0 fill-current text-foreground">
                    <path d={logoPaths.get(t.icon)} />
                  </svg>
                ) : (
                  <span aria-hidden="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-md bg-muted text-sm font-semibold">
                    {t.name[0]}
                  </span>
                )}
                <div class="min-w-0">
                  <a href={t.href} class="font-medium underline-offset-4 hover:underline">{t.name}</a>
                  <p class="text-sm text-muted-foreground">{t.role}</p>
                  <p class="mt-2 text-xs text-muted-foreground">
                    {t.images.length ? <>License: {t.license?.replaceAll('`', '')}</> : 'Connect only'}
                  </p>
                  {t.connect && (
                    <p class="mt-1 text-xs text-muted-foreground">
                      {t.images.length ? 'Or connect: ' : ''}
                      {t.connect}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2 class="mt-16 text-2xl font-semibold tracking-tight">Skills for your coding agent</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Ready commands for Claude Code. AGENTS.md holds the step-by-step recipes every agent follows; these run them for you.
    </p>
    <div class="mt-8 grid gap-10 lg:grid-cols-2">
      <section aria-labelledby="own-skills">
        <h3 id="own-skills" class="font-semibold">Ours, in the repository (MIT-0)</h3>
        {
          groups.map((grp) => {
            const list = ownSkills.filter((s) => s.group === grp);
            return list.length ? (
              <div class="mt-5">
                <h4 class="text-sm font-semibold text-muted-foreground">{grp}</h4>
                <ul class="mt-2 space-y-3">
                  {list.map((s) => (
                    <li>
                      <a href={s.href} class="font-medium underline-offset-4 hover:underline">/{s.name}</a>
                      <span class="text-muted-foreground"> {s.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null;
          })
        }
      </section>
      <section aria-labelledby="their-skills">
        <h3 id="their-skills" class="font-semibold">Others', installed by you</h3>
        <ul class="mt-5 space-y-5">
          {
            thirdPartySkills.map((s) => (
              <li>
                <a href={s.href} class="font-medium underline-offset-4 hover:underline">{s.name}</a>
                <span class="text-sm text-muted-foreground"> by {s.author} · {s.license} · {s.group}</span>
                <p class="mt-1 text-muted-foreground">{s.text}.</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <p class="mt-16 max-w-3xl text-xs text-muted-foreground">
      Names and logos belong to their owners and are shown only to say what is inside or what connects. {site.name} is not affiliated
      with or endorsed by them. Every image with its version and license:
      <a href={file('docs/LICENSES.md')} class="underline underline-offset-4">docs/LICENSES.md</a>.
    </p>
  </div>
</Base>
