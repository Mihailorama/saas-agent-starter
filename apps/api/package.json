{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env.example --env-file-if-exists=../../.env --import ./src/telemetry.ts src/index.ts",
    "start": "node --env-file=../../.env.example --env-file-if-exists=../../.env --import ./src/telemetry.ts src/index.ts",
    "typecheck": "tsc",
    "typecheck:fast": "tsrs --noEmit -p .",
    "test": "vitest run",
    "operators:sync": "node --env-file=../../.env.example --env-file-if-exists=../../.env src/operators-sync.ts",
    "eval:pull": "node --env-file=../../.env.example --env-file-if-exists=../../.env src/eval-pull.ts"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@better-auth/api-key": "^1.7.18",
    "@better-auth/passkey": "^1.7.17",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/otel": "^1.0.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@react-email/render": "^2.2.0",
    "@sentry/node-core": "^10.78.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/interceptors-opentelemetry": "^1.25.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "import-in-the-middle": "^3.6.0",
    "ioredis": "^6.0.0",
    "mailchecker": "^6.0.21",
    "posthog-node": "^5.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "openapi-types": "^12.1.3",
    "otpauth": "^9.6.0",
    "vitest": "^5.1.0"
  }
}
