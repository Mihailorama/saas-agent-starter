{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm check:licenses)",
      "Bash(pnpm e2e)",
      "Bash(pnpm format)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm bench)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d --wait *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo deny check *)",
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(node scripts/vault.mjs status)",
      "Bash(node scripts/vault.mjs lock)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(docker compose down -v *)",
      "Bash(rm -rf *)",
      "Read(~/.config/agent-vault/**)",
      "Bash(bw get *)",
      "Bash(bw list *)",
      "Bash(bw export *)"
    ]
  },
  "extraKnownMarketplaces": {
    "starter-founder": {
      "source": {
        "source": "settings",
        "name": "starter-founder",
        "plugins": [
          {
            "name": "founder-skill",
            "description": "Founder skill pack (MIT): board, competitors, consumer panel, pricing, CFO and more. Opt-in: install it yourself, see docs/validate-idea.md.",
            "source": {
              "source": "github",
              "repo": "Jakeschincariol/founder-skill",
              "sha": "fd9385b0cfe1b96bebce3898fbd506d73eff5a9d"
            }
          }
        ]
      }
    }
  }
}
